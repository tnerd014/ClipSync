{
  "name": "clipsync-desktop",
  "version": "1.0.0",
  "description": "Cross-device sticky note and clipboard sync for Windows desktop (Serverless LAN sync)",
  "author": "ClipSync Team",
  "main": "main.cjs",
  "scripts": {
    "start": "electron main.cjs",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clipsync.desktop",
    "productName": "ClipSync",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.png",
      "icon.ico",
      "dist/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
